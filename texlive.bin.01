      \MH_else:
        \parshape\@ne \@totalleftmargin \linewidth
      \MH_fi:
      \noindent\ignorespaces#1\par}%
    \penalty\predisplaypenalty\vskip\abovedisplayshortskip%
    \vskip-\lineskiplimit

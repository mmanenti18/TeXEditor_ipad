\def\pgfsys@color@cmy@stroke#1#2#3{%
  \pgf@sys@svg@color@cmy#1,#2,#3\relax%
  \let\pgf@sys@svg@last@stroke\pgf@sys@svg@prepared%
  \pgf@sys@svg@gs@color{stroke="\pgf@sys@svg@prepared"}}

  \pgfsetdash{}{+0pt}
  \pgfpathcircle{\pgfqpoint{4.5\pgfutil@tempdima}{0bp}}{4.5\pgfutil@tempdima}
  \pgfusepathqstroke
}%



% A diamond shaped arrow

\pgfarrowsdeclare{diamond}{diamond}
{
  \pgfutil@tempdima=0.4pt%
  \advance\pgfutil@tempdima by.275\pgflinewidth%

}

\def\pgf@sys@svg@append#1#2{%
  \expandafter\let\expandafter\pgf@svg@anim@temp@\csname pgfsys@anim@val@#1\endcsname%
  \ifx\pgf@svg@anim@temp@\pgfutil@empty%

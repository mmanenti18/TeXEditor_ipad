\DeclareOption{dvisvgm}{\def\pgfsysdriver{pgfsys-dvisvgm.def}}

\ProcessOptions

\input{pgfsys.code.tex}
\input{pgfsyssoftpath.code.tex}
\input{pgfsysprotocol.code.tex}


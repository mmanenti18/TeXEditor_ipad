     {<->sub*lmtt/lc/sl}{}
\DeclareFontShape{OT4}{lmtt}{lc}{sl}
     {<-> rm-lmtlco10}{}
\fi
% bold is always bold (b):
\DeclareFontShape{OT4}{lmtt}{b}{n}
     {<-> rm-lmtk10}{}
\DeclareFontShape{OT4}{lmtt}{b}{it}
     {<->sub*lmtt/b/sl}{}
\DeclareFontShape{OT4}{lmtt}{b}{sl}
{<-> rm-lmtko10}{}
\DeclareFontShape{OT4}{lmtt}{bx}{it}
     {<->sub*lmtt/b/sl}{}

       \edef\@tempb{\the\lastskip}%
       \ifx\@tempb\the@zero@skip
       \else
         \unskip
         \ifnum \lastpenalty=\@M
           \vskip\@tempb\vskip\@tempa\relax
         \else
           \remove@discardable@items
         \fi
       \fi
     \else
       \remove@discardable@items
     \fi
}

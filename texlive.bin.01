  }%
}
\let\MT@redefined@patches\@empty
\def\MT@redefine@patch#1#2#3{%
  \g@addto@macro\MT@redefined@patches{%
    \MT@ifdefined@n@TF{MT@patch@@#1}{%
      \MT@gdef@n{MT@patch@@#1}{#2}%

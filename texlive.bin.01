  }
\pgfutil@protected\def\pgfparserlet@f
  {%
    \futurelet\pgfparserlet@argb\pgfparserlet@g
  }
\def\pgfparserlet@g
  {%
    \ifx\pgfparserlet@argb\pgfutil@sptoken
      % will also gobble the \pgfparserlet@h after \fi

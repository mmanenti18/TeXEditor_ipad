        \global\expandafter\font\MT@lsfont=\MT@ls@fontspec@font
      }{%
      \global\expandafter\letterspacefont\MT@lsfont\font@name\MT@letterspace@
      }%
      \MT@ifdefined@c@TF\MT@tr@ispace
        {\let\@tempa\MT@tr@ispace}%

^^X    \MT@map@clist@c\@tempa{\MT@apply@patch{##1}}%
^^Q    \MT@warning@nl{Patches require the etex extensions. Ignoring them}%
  \fi
}
\define@key{MTX}{nopatch}[all]{%
  \def\@tempa{#1}%
  \MT@ifstreq\@tempa{all}
    {\let\@tempa\MT@patches@def}
    {\MT@ifstreq\@tempa{none}
      {\let\@tempa\@empty}

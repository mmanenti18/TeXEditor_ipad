    \MT@map@clist@c\MT@features{\begingroup
      \MT@ifstreq{##1}{tr}\relax{\MT@declare@char@inh{##1}{#1}{#2}}%
    \endgroup}%
  }{%
    \MT@map@clist@c\MT@inh@feat{\begingroup
      \KV@@sp@def\@tempa{##1}%

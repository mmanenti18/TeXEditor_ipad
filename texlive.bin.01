  \else\ifx\pgf@svg@anim@temp@\relax%
    \pgfutil@packageerror{pgfsys}{Unknown animation key '#1'}{}
  \else%
    \edef\pgf@svg@anim@temp@{\pgf@svg@anim@temp@;#2}%
    \expandafter\let\csname pgfsys@anim@val@#1\endcsname\pgf@svg@anim@temp@%
  \fi\fi%
}


\def\makefootline{
    \baselineskip24pt
    \line{\pdfsetcolor{\maincolor}\the\footline}}

\def\makeheadline{%
    \edef\M{\topmark}
    \ifx\M\empty\let\M=\maincolor\fi
    \vbox to 0pt{\vskip-22.5pt
        \line{\vbox to8.5pt{}%
        \pdfsetcolor{\maincolor}\the\headline\pdfsetcolor{\M}}\vss}%
    \nointerlineskip}

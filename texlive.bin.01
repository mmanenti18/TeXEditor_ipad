\DeclareFontFamily{OT4}{lmtt}{\hyphenchar \font\m@ne}

\ifx\lmtt@use@light@as@normal\@empty
% macro defined, so we use the light variant as medium (m), and
% medium as semi-bold (sb):
\DeclareFontShape{OT4}{lmtt}{sb}{n}
     {<-8.5>   rm-lmtt8     <8.5-9.5> rm-lmtt9
      <9.5-11> rm-lmtt10    <11->     rm-lmtt12
      }{}
\DeclareFontShape{OT4}{lmtt}{sb}{it}
     {<-> rm-lmtti10}{}
\DeclareFontShape{OT4}{lmtt}{sb}{sl}
     {<-> rm-lmtto10}{}

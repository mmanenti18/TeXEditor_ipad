\def\MT@patch@info@undo#1{\MT@info{Reverting patch `#1'}}
\let\MT@patches@def\@gobble
\def\MT@define@patch#1#2#3{%
  \MT@ifdefined@n@TF{MT@patch@@#1}{%
    \MT@warning{Patch `#1' already defined.\MessageBreak Cannot define it}%
  }{%

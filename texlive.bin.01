	\def\pgfplotsrevision{0}%
	\def\pgfplotsversion{0.0}%
    \def\pgfplotsversiondatetime{2014-07-01 00:00:00 +100}%
    \def\pgfplotsrevisiondatetime{2014-07-01 00:00:00 +100}%
	\def\pgfplotsversiondate{2014/07/01}%

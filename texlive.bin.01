    \pgf@sys@svg@replace{xlink:href}{\#\pgfsys@id@ref{\pgfsys@anim@val@@id canvas\the\pgf@sys@svg@canvascount}{\pgfsys@anim@val@@type}}%
    \ifx\pgfsys@anim@val@base\pgfutil@empty%
      \let\pgf@sys@svg@base@trans\pgfutil@empty%

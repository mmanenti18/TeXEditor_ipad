		\pgfmath@iftrue{#2}{#3}%
	}
	\def\pgfmath@iftrue{%
		\ifdim\pgfmathresult pt=1.0pt %
			\let\pgfmath@next=\pgfutil@firstoftwo
		\else
			\let\pgfmath@next=\pgfutil@secondoftwo
		\fi
		\pgfmath@next
	}%
	\gdef\pgfplots@glob@TMPa{1}%
}{}%


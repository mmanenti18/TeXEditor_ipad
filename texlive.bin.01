\ProvidesPackageRCS{pgfnodes.sty}

\RequirePackage{pgf}

\PackageWarning{pgfnodes}{This package is obsolete. pgf.sty will load
  node management automatically}

\endinput
% Copyright 2019 by Till Tantau
%

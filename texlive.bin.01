                    \pgf@x-\pgf@x%
                    \pgf@y\shaftwidth\relax%
                    \pgf@y.5\pgf@y%
                }%
            \fi%
            \pgfpathlineto{\arrowboxcorner\pgf@x-\pgf@x}%
            \ifdim\northextend>0pt\relax%
                \pgfpathlineto{%
                    \arrowboxcorner%
                    \pgf@x\shaftwidth\relax%
                    \pgf@x-.5\pgf@x%
                }%
                \pgfpathlineto{%
                    \beforearrowtip%
                    \pgf@y-\pgf@x%
                    \advance\pgf@y\northextend\relax%
                    \advance\pgf@y\arrowheadindent\relax%
                    \pgf@x\shaftwidth\relax%
                    \pgf@x-.5\pgf@x%
                }%
                \pgfpathlineto{%
                    \beforearrowtip%
                    \pgf@xa\pgf@y%
                    \pgf@y-\pgf@x%
                    \advance\pgf@y\northextend\relax%
                    \pgf@x-\pgf@xa%
                }%
                \pgfpathlineto{%
                    \pgf@x0pt\relax%
                    \pgf@y\northextend\relax%
                }%
                \pgfpathlineto{%
                    \beforearrowtip%
                    \pgf@xa\pgf@y%
                    \pgf@y-\pgf@x%
                    \advance\pgf@y\northextend\relax%
                    \pgf@x\pgf@xa%
                }%
                \pgfpathlineto{%
                    \beforearrowtip%
                    \pgf@y-\pgf@x%
                    \advance\pgf@y\northextend\relax%
                    \advance\pgf@y\arrowheadindent\relax%
                    \pgf@x\shaftwidth\relax%
                    \pgf@x.5\pgf@x%

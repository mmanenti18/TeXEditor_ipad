% Abbreviations:

\newcommand{\ctanhttp}{http://mirror.ctan.org/}

% Needed for 09:

\newcommand\cs[1]{\texttt{\textbackslash#1}}

% Some logical markup:

\newcommand*\class[1]{\texttt{#1}}
\newcommand*\package[1]{\textsf{#1}}

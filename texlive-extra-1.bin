   {\blx@imc@getfieldannotation@i}
   {\blx@imc@getfieldannotation@i[\blx@tempa]}}

\def\blx@imc@getfieldannotation@i[#1]{%
 \ifstrempty{#1}
   {\blx@imc@getfieldannotation@i[\blx@tempa]}
   {\@ifnextchar[%]
      {\blx@imc@getfieldannotation@ii{#1}}
      {\blx@imc@getfieldannotation@ii{#1}[default]}}}


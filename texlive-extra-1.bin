  \begingroup
  \let\nolabel\blx@nolabel@setup
  \let\blx@tempa\@empty
  #1%
  \global\let\blx@nolabel\blx@tempa
  \endgroup}
\@onlypreamble\DeclareNolabel

\newcommand*{\blx@nolabel@setup}[1]{%
  \eappto\blx@tempa{%
    \blx@xml@nolabel{#1}}}


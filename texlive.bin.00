      \fi%
    \else%
      \expandafter\ifx\csname r@#3@cref\endcsname\relax%
        \protect\G@refundefinedtrue%
        \cref@getlabel{#2}{\@labela}%
        \@labela--\nfss@text{\reset@font\bfseries ??}%

  \Hy@WarningNoLine{%
    Option `#1' is no longer used%
  }%
  \define@key{Hyp}{#1}[true]{}%
}
\def\Hy@temp#1{%
  \define@key{Hyp}{#1}[true]{%
    \Hy@ObsoletePaperOption{#1}%
  }%
}

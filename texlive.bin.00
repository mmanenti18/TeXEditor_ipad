       \def\caption@threeparttabletype{#1#2}}%
%%% \caption@setposition{auto}% ?
    \caption@clearmargin
    \caption@setoptions\caption@threeparttabletype
    \caption@setanchor}%
  \def\TPT@caption#1[#2]#3{%

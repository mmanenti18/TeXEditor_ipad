      \edef\@curroptions{\@ptionlist{\@currname.\@currext}}%
      \@expandtwoargs\in@{,#1,}{,\@classoptionslist,\@curroptions,}%
      \ifin@%
        \AtBeginDocument{%
          \expandafter\cref@addto\csname extras#1\endcsname{#2}}%
      \fi}{}}}%

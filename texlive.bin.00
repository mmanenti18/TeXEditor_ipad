                 {\@testwrongwidth}{float order in 2-column}%
\def\@testwrongwidth #1{%
  \ifdim\dp#1=\f@depth
  \else
    \global\@testtrue
  \fi}%
\let\f@depth\z@
\EndIncludeInRelease

\def\Hy@BeginAnnot#1{%
  \global\advance\c@Hy@AnnotLevel\@ne
  \ifnum\c@Hy@AnnotLevel=\@ne
    #1%
  \fi
}
\def\Hy@EndAnnot{%
  \ifnum\value{Hy@AnnotLevel}=\@ne

        \cref@poorman@text\expandafter{\@tempa^^J}%
      \lowercase{\edef\@tempa{%
          s/||renewcommand<||crefmiddleconjunction><.*>//g}}%
      \expandafter\g@addto@macro\expandafter%
        \cref@poorman@text\expandafter{\@tempa^^J}%
      \lowercase{\edef\@tempa{%

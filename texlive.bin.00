\def\caption@@declaresubtype#1[#2]#3{%
  \@ifundefined{c@#3}%
    {\caption@Error{No float type '#3' defined}}%
    {\@ifundefined{c@sub#3}%
       {\caption@Debug{New subtype `sub#3'}%

            \else
                \expandafter\@trimbox
            \fi
        }{#1}%
    }%
}
\define@adjboxkey{Trim}{\trimbox@{#1}}%
\define@adjboxkey{Clip}{\clipbox@{#1}}
\define@adjboxkey{rndcorners}{\rndcornersbox@{#1}}
\define@adjboxkey{rndframe}{%

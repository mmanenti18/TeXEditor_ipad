\let\HyOpt@DriverFallback\@empty
\define@key{Hyp}{driverfallback}{%
  \ifHy@DviMode
    \def\HyOpt@DriverFallback{#1}%
    \Hy@Match\HyOpt@DriverFallback{}{%
      ^(|dvipdfm|dvipdfmx|dvips|dvipsone|dviwindo|hypertex|ps2pdf|%
       latex2html|tex4ht)$%
    }{}{%
      \Hy@Warning{%

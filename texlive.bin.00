\def\refstepcounter#1{%
  \legacy_if:nF {Hy@pdfstring}
   {
    \H@refstepcounter{#1}%
    \bool_lazy_and:nnT
      { \l__hyp_target_create_bool }
      { ! \legacy_if_p:n{@skiphyperref} }
      {
        \legacy_if:nTF {@hyper@item}

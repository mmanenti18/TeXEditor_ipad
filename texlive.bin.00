\AtBeginShipoutFirst{%
  \ifHy@setpagesize
    \begingroup
     \ifnum\mag=\@m
      \ifdim\stockwidth>\z@
        \ifdim\stockheight>\z@
         \special{papersize=\the\stockwidth,\the\stockheight}%
        \else
          \ifdim\paperwidth>\z@
            \ifdim\paperheight>\z@
              \special{papersize=\the\paperwidth,\the\paperheight}%
            \fi
          \fi
        \fi
      \else
        \ifdim\stockwidth=\z@
          \ifdim\paperwidth>\z@
            \ifdim\paperheight>\z@
              \special{papersize=\the\paperwidth,\the\paperheight}%
            \fi
          \fi
        \fi
      \fi
     \fi
    \endgroup
  \fi
  \Hy@DisableOption{setpagesize}%
}

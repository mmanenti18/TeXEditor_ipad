  \caption@ifdefined\GOfrench
    {\def\caption@tempa{\g@addto@macro\GOfrench}}%
    {\let\caption@tempa\@firstofone}%
  \caption@tempa{%
    \let\captionfont\captionfont@ORI
    \let\captionfont@ORI\@undefined
    \let\captionlabelfont\captionlabelfont@ORI

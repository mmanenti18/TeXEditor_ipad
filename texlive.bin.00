      }
      {
        \msg_error:nnn { socket } { undeclared } {#1}
      }
}
\cs_new_protected:Npn \socket_set_plug:nnn #1#2#3 {
  \str_if_exist:cTF { l__socket_#1_plug_str }
      {
        \cs_if_exist:cTF { __socket_#1_plug_#2:w }
          {
            \cs_generate_from_arg_count:cNnn
              { __socket_#1_plug_#2:w }
              \cs_set_protected:Npn
              { \int_use:c { c__socket_#1_args_int } }
              {#3}
            \__socket_debug_term:n
              {  Plug~ '#2'~ for~ socket~ '#1'~ changed. }
          }
          {
            \msg_error:nnnn { socket } { plug-undeclared } {#1} {#2}
          }
      }
      {
        \msg_error:nnn { socket } { undeclared } {#1}
      }
}
\cs_new_protected:Npn \socket_assign_plug:nn #1 #2 {
  \str_if_exist:cTF { l__socket_#1_plug_str }
      {
        \cs_if_exist:cTF { __socket_#1_plug_#2:w }
          {
            \__socket_debug_term:n
              { Replacing~ plug~ '\str_use:c { l__socket_#1_plug_str }'~
                with~ '#2'~ in~ socket~ '#1'. }
            \str_set:cn { l__socket_#1_plug_str } {#2}
          }
          {
            \msg_error:nnnn { socket } { plug-undeclared } {#1} {#2}
          }

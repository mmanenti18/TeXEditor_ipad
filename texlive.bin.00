\IncludeInRelease{0000/00/00}%
                 {\includeonly}{Spaces in file names}%
\def\includeonly#1{%
  \@partswtrue
  \edef\@partlist{\zap@space#1 \@empty}}

\def\include#1{\relax
  \ifnum\@auxout=\@partaux
    \@latex@error{\string\include\space cannot be nested}\@eha
  \else \@include#1 \fi}

\EndIncludeInRelease
\IncludeInRelease{2022/06/01}%
                 {\@include}{Spaces in file names and hooks}%
\def\@include#1 {%
\ifx\@nodocument\relax
  \clearpage
  \if@filesw
    \immediate\write\@mainaux{\string\@input{#1.aux}}%
  \fi
  \@tempswatrue
  \if@partsw
    \@tempswafalse
    \edef\reserved@b{#1}%
    \@for\reserved@a:=\@partlist\do
      {\ifx\reserved@a\reserved@b\@tempswatrue\fi}%
  \fi
  \if@tempswa
    \let\@auxout\@partaux
    \if@filesw
      \immediate\openout\@partaux "#1.aux"
      \immediate\write\@partaux{\relax}%
    \fi
    \@filehook@set@CurrentFile
    \UseHook{include/before}%
    \UseOneTimeHook{include/#1/before}%
    \@input@{#1.tex}%
    \UseOneTimeHook{include/#1/end}%
    \UseHook{include/end}%
    \clearpage
    \UseOneTimeHook{include/#1/after}%
    \UseHook{include/after}%
    \clearpage
    \@writeckpt{#1}%
    \if@filesw
      \immediate\closeout\@partaux
    \fi
  \else
    \deadcycles\z@
    \@nameuse{cp@#1}%
    \UseHook{include/excluded}%
    \UseOneTimeHook{include/#1/excluded}%

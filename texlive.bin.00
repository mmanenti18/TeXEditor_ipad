        \expandafter\expandafter\expandafter\caption
          \expandafter\expandafter\expandafter[%
          \expandafter\expandafter\expandafter{%
          \expandafter\caption@SClentry\expandafter}\expandafter]%
          \expandafter{\caption@SCtext}%

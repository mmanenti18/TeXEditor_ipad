\ifcase\bbl@engine\else
% Contributed by Udi Fogiel, with some changes
\def\BabelHebrewNumeralMarkerSingle{×³}% Number is a single letter
\def\BabelHebrewNumeralMarkerFinal{×´}%  Before final letter

\@namedef{bbl@cntr@letters.long@\CurrentOption}#1%
  {\expandafter\@hebrew@@numeral\expandafter{\the\numexpr#1}0}

\@namedef{bbl@cntr@letters.gershayim@\CurrentOption}#1%
  {\expandafter\@hebrew@@numeral\expandafter{\the\numexpr#1}1}

\@namedef{bbl@cntr@letters.final@\CurrentOption}#1%
  {\expandafter\@hebrew@@numeral\expandafter{\the\numexpr#1}2}

\def\hebrew@num@trunc#1#2{%
  \ifnum\numexpr #1-#2*\numexpr #1/#2\relax<0
    \the\numexpr #1/#2-1\relax
  \else
    \the\numexpr #1/#2\relax
  \fi}
  
\def\@hebrew@@numeral#1#2{%
  \ifnum#1<\z@\bbl@error{Invalid Hebrew numeral (<0)}{Not supported.}%
  \else
    \ifnum#1<1000
		    \hebrew@num@nomil{#1}{#2}%
    \else
      \ifnum#1>999999 % For forward compatibility
        \bbl@error{Hebrew numeral too large (>999999)}%
          {Currently this is the limit.}%
        #1%
      \else
        \expandafter\@hebrew@@numeral\expandafter
          {\the\numexpr\hebrew@num@trunc{#1}{1000}}0%
        \BabelHebrewNumeralMarkerSingle
        \expandafter\hebrew@num@nomil\expandafter
          {\the\numexpr #1-1000*\hebrew@num@trunc{#1}{1000}}{#2}%
      \fi
    \fi
  \fi}
  
\def\hebrew@alph@zero{}
\def\hebrew@num@nomil#1#2{%
  \ifcase\hebrew@num@trunc{#1}{100}%    print nothing if no hundreds
    \or ×§\ifnum#2>0 \ifnum#1=100 \BabelHebrewNumeralMarkerSingle\fi\fi
    \or ×¨\ifnum#2>0 \ifnum#1=200 \BabelHebrewNumeralMarkerSingle\fi\fi
    \or ×©\ifnum#2>0 \ifnum#1=300 \BabelHebrewNumeralMarkerSingle\fi\fi
    \or ×ª\ifnum#2>0 \ifnum#1=400 \BabelHebrewNumeralMarkerSingle\fi\fi
    \or ×ª\ifnum#2>0 \ifnum#1=500 \BabelHebrewNumeralMarkerFinal\fi\fi ×§%
    \or ×ª\ifnum#2>0 \ifnum#1=600 \BabelHebrewNumeralMarkerFinal\fi\fi ×¨%
    \or ×ª\ifnum#2>0 \ifnum#1=700 \BabelHebrewNumeralMarkerFinal\fi\fi ×©%
    \or ×ª\ifnum#2>0 \ifnum#1=800 \BabelHebrewNumeralMarkerFinal\fi\fi ×ª%
    \or ×ª×ª\ifnum#2>0 \ifnum#1=900 \BabelHebrewNumeralMarkerFinal\fi\fi ×§%
  \fi
  \ifnum\the\numexpr #1-100*\hebrew@num@trunc{#1}{100} = 16
    \ifnum#2>0 ×˜\BabelHebrewNumeralMarkerFinal ×–\else ×˜×–\fi  % tet-zayin
  \else\ifnum\the\numexpr #1 - 100*\hebrew@num@trunc{#1}{100} = 15
    \ifnum#2>0 ×˜\BabelHebrewNumeralMarkerFinal ×•\else ×˜×•\fi  % tet-vav
  \else  % print nothing if no tens:
  \ifcase\expandafter\hebrew@num@trunc\expandafter
      {\the\numexpr#1-100*\hebrew@num@trunc{#1}{100}}{10}% 
    \or\ifnum\numexpr #1-10*\hebrew@num@trunc{#1}{10}>0 ×™\else
        \ifnum#2>0 \ifnum#1=10 ×™\BabelHebrewNumeralMarkerSingle
        \else\BabelHebrewNumeralMarkerFinal ×™\fi\else ×™\fi
      \fi
    \or\ifnum\numexpr #1-10*\hebrew@num@trunc{#1}{10}>0 ×›\else
         \ifnum#2>0 \ifnum#1>20 \BabelHebrewNumeralMarkerFinal\fi\fi
         \if #22×š\else ×›\fi\ifnum#2>0 \ifnum#1=20 \BabelHebrewNumeralMarkerSingle\fi\fi
       \fi
    \or\ifnum\numexpr #1-10*\hebrew@num@trunc{#1}{10}>0 ×œ\else
         \ifnum#2>0 \ifnum#1=30 ×œ\BabelHebrewNumeralMarkerSingle
         \else\BabelHebrewNumeralMarkerFinal ×œ\fi\else ×œ\fi
       \fi
    \or\ifnum\numexpr #1-10*\hebrew@num@trunc{#1}{10}>0 ×ž\else
         \ifnum#2>0 \ifnum#1>40 \BabelHebrewNumeralMarkerFinal\fi\fi
         \if #22×\else ×ž\fi\ifnum#2>0 \ifnum#1=40 \BabelHebrewNumeralMarkerSingle\fi\fi
       \fi
    \or\ifnum\numexpr #1-10*\hebrew@num@trunc{#1}{10}>0 × \else
         \ifnum#2>0 \ifnum#1>50 \BabelHebrewNumeralMarkerFinal\fi\fi
         \if #22×Ÿ\else × \fi\ifnum#2>0 \ifnum#1=50 \BabelHebrewNumeralMarkerSingle\fi\fi
       \fi
    \or\ifnum\numexpr #1-10*\hebrew@num@trunc{#1}{10}>0 ×¡\else
         \ifnum#2>0 \ifnum#1=60 ×¡\BabelHebrewNumeralMarkerSingle
         \else\BabelHebrewNumeralMarkerFinal ×¡\fi\else ×¡\fi
       \fi
    \or\ifnum\numexpr #1-10*\hebrew@num@trunc{#1}{10}>0 ×¢\else
         \ifnum#2>0 \ifnum#1=70 ×¢\BabelHebrewNumeralMarkerSingle
         \else\BabelHebrewNumeralMarkerFinal ×¢\fi\else ×¢\fi
       \fi
    \or\ifnum\numexpr #1-10*\hebrew@num@trunc{#1}{10}>0 ×¤\else
         \ifnum#2>0 \ifnum#1>80 \BabelHebrewNumeralMarkerFinal\fi\fi
         \if #22×£\else ×¤\fi\ifnum#2>0 \ifnum#1=80 \BabelHebrewNumeralMarkerSingle\fi\fi
       \fi
    \or\ifnum\numexpr #1-10*\hebrew@num@trunc{#1}{10}>0 ×¦\else
        \ifnum#2>0 \ifnum#1>90 \BabelHebrewNumeralMarkerFinal\fi\fi
        \if #22×¥\else ×¦\fi\ifnum#2>0 \ifnum#1=90 \BabelHebrewNumeralMarkerSingle \fi\fi
      \fi
  \fi
  \ifcase\numexpr #1-10*\hebrew@num@trunc{#1}{10}%
      \hebrew@alph@zero %  empty but can be defined if desired
      \or\ifnum#2>0 \ifnum#1=1 ×\BabelHebrewNumeralMarkerSingle
        \else\BabelHebrewNumeralMarkerFinal ×\fi\else ×\fi
      \or\ifnum#2>0 \ifnum#1=2 ×‘\BabelHebrewNumeralMarkerSingle
        \else\BabelHebrewNumeralMarkerFinal ×‘\fi\else ×‘\fi
      \or\ifnum#2>0 \ifnum#1=3 ×’\BabelHebrewNumeralMarkerSingle
        \else\BabelHebrewNumeralMarkerFinal ×’\fi\else ×’\fi
      \or\ifnum#2>0 \ifnum#1=4 ×“\BabelHebrewNumeralMarkerSingle
        \else\BabelHebrewNumeralMarkerFinal ×“\fi\else ×“\fi
      \or\ifnum#2>0 \ifnum#1=5 ×”\BabelHebrewNumeralMarkerSingle
        \else\BabelHebrewNumeralMarkerFinal ×”\fi\else ×”\fi
      \or\ifnum#2>0 \ifnum#1=6 ×•\BabelHebrewNumeralMarkerSingle
        \else\BabelHebrewNumeralMarkerFinal ×•\fi\else ×•\fi
      \or\ifnum#2>0 \ifnum#1=7 ×–\BabelHebrewNumeralMarkerSingle
        \else\BabelHebrewNumeralMarkerFinal ×–\fi\else ×–\fi
      \or\ifnum#2>0 \ifnum#1=8 ×—\BabelHebrewNumeralMarkerSingle
        \else\BabelHebrewNumeralMarkerFinal ×—\fi\else ×—\fi
      \or\ifnum#2>0 \ifnum#1=9 ×˜\BabelHebrewNumeralMarkerSingle
        \else\BabelHebrewNumeralMarkerFinal ×˜\fi\else ×˜\fi
  \fi\fi\fi}

\fi


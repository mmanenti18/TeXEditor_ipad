          \space undefined}%
      \else%
        \cref@gettype{#2}{\@typea}%
        \cref@gettype{#3}{\@typeb}%
        \cref@getlabel{#2}{\@labela}%
        \cref@getlabel{#3}{\@labelb}%
        \edef\@format{\expandafter\noexpand%
          \csname #1range@\@typea @format#4\endcsname}%

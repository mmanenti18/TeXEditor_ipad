  \def\@dh{dh}%
  \ClassWarning{\@classname}{\string\dh\space unavailable without amsfonts;
    replaced by 'dh'}%
}{%
  \edef\@dh{\noexpand\mathhexbox{\hexnumber@\symAMSb}67}%

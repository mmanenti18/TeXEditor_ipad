              /Event/View%
              /OCGs \OBJ@OCGs
              /Category[/View]%
            >>%
            <<%
              /Event/Print%
              /OCGs \OBJ@OCGs
              /Category[/Print]%
            >>%
            <<%
              /Event/Export%
              /OCGs \OBJ@OCGs
              /Category[/Print]%
            >>%
          ]%
        >>%
      >>%

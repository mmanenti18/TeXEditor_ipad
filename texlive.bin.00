  {
    \__graphics_bb_restore:nF {#1}
      {
        \ior_open:Nn \l__graphics_internal_ior {#1}
        \ior_if_eof:NTF \l__graphics_internal_ior
          { \msg_error:nnn { graphics } { graphic-not-found } {#1} }
          {
            \dim_zero:N \l__graphics_llx_dim

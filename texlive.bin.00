%\DeclareQuoteGlyph{X2}{62}%  = >> ligature = \guillemotright

\DeclareQuoteGlyph{LCY}{13}%  = \textquotesingle
\DeclareQuoteGlyph{LCY}{34}%  = \textquotedbl

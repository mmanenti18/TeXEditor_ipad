\ifHy@ocgcolorlinks
  \def\OBJ@OCG@view{@OCG@view}%
  \@pdfm@mark{%
    obj \OBJ@OCG@view <<%
      /Type/OCG%
      /Name(View)%
      /Usage<<%
        /Print<<%
          /PrintState/OFF%
        >>%
        /View<<%
          /ViewState/ON%
        >>%
      >>%
    >>%
  }%
  \@pdfm@mark{close \OBJ@OCG@view}%
  \def\OBJ@OCG@print{@OCG@print}%
  \@pdfm@mark{%
    obj \OBJ@OCG@print <<%
      /Type/OCG%
      /Name(Print)%
      /Usage<<%
        /Print<<%
          /PrintState/ON%
        >>%
        /View<<%
          /ViewState/OFF%
        >>%

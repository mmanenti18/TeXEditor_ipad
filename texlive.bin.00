    \fi}}%
\def\cref@processgroupall#1#2#3{%
  \cref@stack@init{\@tempstack}%
  \cref@stack@dropempty{#2}%
  \edef\@firstref{\cref@stack@top{#2}}%
  \cref@isstackfull{#2}%

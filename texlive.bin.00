  \begingroup
    \escapechar=\m@ne
    \xdef\Hy@gtemp{%
      \expandafter\noexpand\csname HyWrap@\string#1\endcsname
    }%
  \endgroup
  \edef#1{%
    \noexpand\Hy@wrapper@babel
    \expandafter\noexpand\Hy@gtemp
  }%
  \expandafter\def\Hy@gtemp
}

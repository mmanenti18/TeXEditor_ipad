  \fi
}
\def\Hy@Test@Alph#1{%
  \ifcase#1\or
    A\or B\or C\or D\or E\or F\or G\or H\or I\or J\or
    K\or L\or M\or N\or O\or P\or Q\or R\or S\or T\or

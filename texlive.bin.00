\IncludeInRelease{0000/00/00}%
  {\@startdblcolumn}{float order in 2-column}%
\def \@startdblcolumn {%
% \global \@colht \textheight
  \@tryfcolumn \@dbldeferlist
  \if@fcolmade
    \fl@trace{PAGE: double float page completed}%
  \else
    \begingroup
      \let \reserved@b \@dbldeferlist

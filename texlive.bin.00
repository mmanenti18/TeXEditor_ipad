  \@ifbothcounters{#1}{#2}{\@removefromreset{#1}{#2}}}
\def\counterwithout@x#1#2{%
  \@ifbothcounters{#1}{#2}%
      {\@removefromreset{#1}{#2}%
       \expandafter

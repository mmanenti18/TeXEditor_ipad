\cs_new_protected:Npn \socket_show:n #1 {\socket_log:n {#1} \errmessage{}}
\cs_new_protected:Npn \socket_new_plug:nnn #1#2#3 {
  \str_if_exist:cTF { l__socket_#1_plug_str }
      {
        \cs_if_exist:cTF { __socket_#1_plug_#2:w }
          {
            \msg_error:nnnn { socket } { plug-already-declared } {#1} {#2}
          }
          {
            \cs_generate_from_arg_count:cNnn
              { __socket_#1_plug_#2:w }
              \cs_new_protected:Npn
              { \int_use:c { c__socket_#1_args_int } }
              {#3}
            \seq_put_right:cn { l__socket_#1_plugs_seq } {#2}
            \__socket_debug_term:n
              { Plug~ '#2'~ for~ socket~ '#1'~ declared. }

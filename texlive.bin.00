\newcommand\caption@ForEachType[1]{%
  \caption@ifundefined\ForEachFloatingEnvironment
    {\def\@elt##1{#1}%
      \caption@ifundefined\c@figure\@gobble\@elt{figure}%
      \caption@ifundefined\c@table\@gobble\@elt{table}%
      \let\@elt\relax

      -\g_EQ_widesttag_dim-\multlinetaggap-\multlinegap}%
  \MH_or:
    \MH_addtolength:dn \l_EQ_temp_linewidth_dim{%
      -\g_EQ_widesttag_dim-\multlinetaggap-\multlinegap}%

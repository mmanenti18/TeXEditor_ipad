\mode<presentation>

\setbeamertemplate{items}[circle]
\setbeamertemplate{sections/subsections in toc}[circle]

\mode
<all>
% Copyright 2007 by Till Tantau
% Copyright 2012--2015 by Vedran Mileti\'c, Joseph Wright

\DeclareRobustCommand{\Cref}[1]{\@cref{Cref}{#1}}%
\DeclareRobustCommand{\crefrange}[2]{\@setcrefrange{#1}{#2}{}}%
\DeclareRobustCommand{\Crefrange}[2]{\@setCrefrange{#1}{#2}{}}%

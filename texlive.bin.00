  \@crefcopyformats{enumii}{enumiii}%
  \@crefcopyformats{enumiii}{enumiv}%
  \@crefcopyformats{enumiv}{enumv}%
  \@labelcrefdefinedefaultformats%
  %
  \let\cref@language\relax%
}%  end of \AtBeginDocument

\def\literalps@out#1{\special{pS:#1}}%
\def\headerps@out#1{\immediate\special{pS:#1}}%
\input{pdfmark.def}%
\ifx\@pdfproducer\relax
  \ifnum\OpMode=\@ne
    \def\@pdfproducer{VTeX}%
